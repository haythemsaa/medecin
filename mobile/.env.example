// API Configuration
API_URL=http://localhost:8000/api

// For Android Emulator use: http://10.0.2.2:8000/api
// For iOS Simulator use: http://localhost:8000/api
// For physical device use your machine's IP: http://192.168.1.X:8000/api

// Google Maps API Key (for geolocation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

// WebRTC Configuration (for video consultations)
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=turn:your-turn-server.com:3478
WEBRTC_TURN_USERNAME=username
WEBRTC_TURN_CREDENTIAL=password

// Payment Configuration
PAYMENT_PUBLIC_KEY=your_payment_public_key

// App Configuration
APP_NAME=Seha Digital
APP_VERSION=4.0.0
