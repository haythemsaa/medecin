APP_NAME="Seha Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Tunis
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sehadigital
DB_USERNAME=sehadigital
DB_PASSWORD=sehadigital_secure_password

BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@sehadigital.tn"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Configuration (Tunisian providers)
SMS_PROVIDER=tunisie_telecom
SMS_API_KEY=
SMS_SENDER_NAME="SehaDigital"

# Payment Gateway (Tunisian)
PAYMENT_GATEWAY=smt
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_ENVIRONMENT=sandbox

# WebRTC Configuration
TURN_SERVER_URL=turn:turn.sehadigital.tn:3478
TURN_USERNAME=
TURN_PASSWORD=
STUN_SERVER_URL=stun:stun.sehadigital.tn:3478

# File Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# INPDP Compliance
DATA_RETENTION_YEARS=10
ENCRYPTION_KEY=
AUDIT_LOG_ENABLED=true

# CNAM Integration (Future)
CNAM_API_URL=
CNAM_API_KEY=
CNAM_ENABLED=false

# Pusher/Websockets for real-time
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
